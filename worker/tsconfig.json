{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "..",
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": ["./**/*.ts", "../types/**/*.ts", "../lib/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
